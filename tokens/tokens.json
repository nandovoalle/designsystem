{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design Tokens extraídos de https://twist-close-27620285.figma.site/",
  "$version": "1.0.0",
  "color": {
    "brand": {
      "blue-900": { "$value": "#13283C", "$type": "color", "$description": "Brand principal, dark navy" },
      "blue-700": { "$value": "#304A64", "$type": "color", "$description": "Brand medium navy" },
      "blue-300": { "$value": "#BFD8F3", "$type": "color", "$description": "Brand light blue" },
      "blue-100": { "$value": "#9CB1C8", "$type": "color", "$description": "Brand gray blue" }
    },
    "text": {
      "primary":   { "$value": "#4A4A4A", "$type": "color" },
      "secondary": { "$value": "#666666", "$type": "color" },
      "disabled":  { "$value": "#9E9E9E", "$type": "color" },
      "inverse":   { "$value": "#FFFFFF", "$type": "color" },
      "link":      { "$value": "#304A64", "$type": "color" }
    },
    "state": {
      "success":  { "$value": "#4BAF50", "$type": "color" },
      "info":     { "$value": "#0094EE", "$type": "color" },
      "warning":  { "$value": "#E9C16C", "$type": "color" },
      "error":    { "$value": "#E9786B", "$type": "color" },
      "orange":   { "$value": "#FF9E5F", "$type": "color" },
      "purple":   { "$value": "#8080EC", "$type": "color" },
      "staging":  { "$value": "#F6BD67", "$type": "color" }
    },
    "alert": {
      "blue":   { "text": { "$value": "#304A64" }, "bg": { "$value": "#E6F4FD" } },
      "grey":   { "text": { "$value": "#4A4A4A" }, "bg": { "$value": "#F0F0F0" } },
      "green":  { "text": { "$value": "#2D7A31" }, "bg": { "$value": "#D4EDDA" } },
      "red":    { "text": { "$value": "#C0392B" }, "bg": { "$value": "#F8D7DA" } },
      "yellow": { "text": { "$value": "#856404" }, "bg": { "$value": "#FFF3CD" } }
    },
    "surface": {
      "1": { "$value": "#32353A", "$type": "color", "$description": "Surface principal dark" },
      "2": { "$value": "#1D2024", "$type": "color" },
      "3": { "$value": "#0B0E12", "$type": "color", "$description": "Fundo mais escuro" },
      "4": { "$value": "#2A2D31", "$type": "color" },
      "5": { "$value": "#323438", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": "\"Red Hat Display\", sans-serif", "$type": "fontFamily" },
      "sans":    { "$value": "ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "ui-monospace, SFMono-Regular, Consolas, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "caption": { "$value": "11px", "$type": "dimension" },
      "label":   { "$value": "12px", "$type": "dimension" },
      "sm":      { "$value": "14px", "$type": "dimension" },
      "base":    { "$value": "16px", "$type": "dimension" },
      "lg":      { "$value": "18px", "$type": "dimension" },
      "xl":      { "$value": "20px", "$type": "dimension" },
      "2xl":     { "$value": "22px", "$type": "dimension" },
      "3xl":     { "$value": "24px", "$type": "dimension" },
      "4xl":     { "$value": "28px", "$type": "dimension" },
      "5xl":     { "$value": "32px", "$type": "dimension" }
    },
    "fontWeight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight":    { "$value": "16px", "$type": "dimension" },
      "snug":     { "$value": "20px", "$type": "dimension" },
      "normal":   { "$value": "24px", "$type": "dimension" },
      "relaxed":  { "$value": "27px", "$type": "dimension" },
      "loose-sm": { "$value": "28px", "$type": "dimension" },
      "loose-md": { "$value": "30px", "$type": "dimension" },
      "loose-lg": { "$value": "32px", "$type": "dimension" },
      "loose-xl": { "$value": "36px", "$type": "dimension" },
      "loose-2xl":{ "$value": "40px", "$type": "dimension" }
    }
  },
  "spacing": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "17": { "$value": "68px", "$type": "dimension", "$description": "Content area padding" }
  },
  "borderRadius": {
    "none":    { "$value": "0px",    "$type": "dimension" },
    "sm":      { "$value": "4px",    "$type": "dimension" },
    "md":      { "$value": "8px",    "$type": "dimension" },
    "lg":      { "$value": "10px",   "$type": "dimension" },
    "xl":      { "$value": "14px",   "$type": "dimension" },
    "favicon": { "$value": "2px",    "$type": "dimension" },
    "full":    { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "xs": { "$value": "rgba(0,0,0,0.05) 0px 1px 2px 0px", "$type": "shadow" },
    "sm": { "$value": "rgba(0,0,0,0.1) 0px 1px 3px 0px, rgba(0,0,0,0.1) 0px 1px 2px -1px", "$type": "shadow" },
    "md": { "$value": "rgba(0,0,0,0.15) 0px 4px 6px -1px, rgba(0,0,0,0.1) 0px 2px 4px -2px", "$type": "shadow" }
  },
  "transition": {
    "duration": {
      "fast": { "$value": "100ms", "$type": "duration" },
      "base": { "$value": "150ms", "$type": "duration" },
      "slow": { "$value": "300ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" }
    }
  },
  "layout": {
    "sidebarWidth":    { "$value": "256px",  "$type": "dimension" },
    "contentMaxWidth": { "$value": "1152px", "$type": "dimension" },
    "navItemHeight":   { "$value": "36px",   "$type": "dimension" },
    "contentPadding":  { "$value": "68px",   "$type": "dimension" }
  },
  "zIndex": {
    "sidebar":  { "$value": 100, "$type": "number" },
    "dropdown": { "$value": 200, "$type": "number" },
    "modal":    { "$value": 300, "$type": "number" },
    "tooltip":  { "$value": 400, "$type": "number" },
    "toast":    { "$value": 500, "$type": "number" }
  },
  "favicon": {
    "sizes": {
      "xs":  { "$value": "16px", "$description": "Padrão browsers" },
      "sm":  { "$value": "32px", "$description": "Alguns navegadores" },
      "md":  { "$value": "48px", "$description": "Atalhos e bookmarks" },
      "lg":  { "$value": "64px", "$description": "Alta resolução" },
      "xl":  { "$value": "128px" },
      "2xl": { "$value": "256px" }
    },
    "lightBg":     { "$value": "#13283C" },
    "darkBg":      { "$value": "#FFFFFF" },
    "badgeColor":  { "$value": "#E9786B" },
    "badgeRadius": { "$value": "10px" }
  }
}
